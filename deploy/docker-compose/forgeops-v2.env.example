# ForgeOps 2.0 部署环境变量模板（复制为 forgeops-v2.env 并填入真实值）
# OPS-03：没有任何默认秘密；缺失必需项时 compose/服务必须显式失败。

# --- 数据库（必需） ---
FORGEOPS_DB_USER=forgeops
FORGEOPS_DB_PASSWORD=change-me-postgres-password
FORGEOPS_DB_NAME=forgeops_v2

# --- 安全（必需）：浏览器短期身份令牌签名秘密 ---
FORGEOPS_V2_SECURITY_TOKEN_SECRET=change-me-32-byte-random-secret

# --- Runtime 服务凭证（必需）：Gateway→Runtime 的 Bearer Token ---
FORGEOPS_RUNTIME_SERVICE_TOKEN=change-me-runtime-service-token

# --- Paseo daemon（本机部署时改 ws://host.docker.internal:6767/ws） ---
FORGEOPS_PASEO_URL=ws://paseo-daemon:6767/ws
FORGEOPS_PASEO_PASSWORD=
FORGEOPS_PASEO_PROVIDER=codex/gpt-5.5

# --- GitHub 交付边界（默认关闭；启用时 Secret 必填） ---
FORGEOPS_V2_GITHUB_ENABLED=false
FORGEOPS_V2_GITHUB_WEBHOOK_SECRET=
FORGEOPS_V2_GITHUB_API_TOKEN=
# ADR-0005 机器身份 Merge Token（与人工 Token 分离；未配置则 autoMerge 不可用）
FORGEOPS_V2_GITHUB_MACHINE_MERGE_TOKEN=

# --- 验证层 ---
FORGEOPS_V2_PLANNER_ENABLED=true
FORGEOPS_V2_EXECUTOR_ENABLED=false
# 执行器镜像白名单（逗号分隔；均为预扫描镜像）
FORGEOPS_V2_EXECUTOR_IMAGES=
