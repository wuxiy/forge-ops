{
  "name": "@forgeops/feedback-react",
  "version": "0.1.0",
  "description": "ForgeOps Feedback SDK for React - init once in main.tsx, or mount <ForgeOpsFeedback /> in your tree",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeops/feedback-core": "workspace:*",
    "@forgeops/feedback-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
