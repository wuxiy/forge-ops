{
  "name": "@forgeops/feedback-dom",
  "version": "0.1.0",
  "description": "ForgeOps Feedback DOM widget - framework-agnostic UI mounted anywhere (used by vue/vue2/react wrappers)",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeops/feedback-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
