{
  "name": "@forgeops/feedback-vue2",
  "version": "0.1.0",
  "description": "ForgeOps Feedback SDK for Vue 2 - app.use() once, feedback entry mounted automatically",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeops/feedback-core": "workspace:*",
    "@forgeops/feedback-dom": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
