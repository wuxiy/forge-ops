{
  "name": "@forgeops/feedback-core",
  "version": "2.0.0-experimental.0",
  "description": "ForgeOps 2.0 framework-neutral feedback core",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && node --experimental-specifier-resolution=node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
